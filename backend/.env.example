# PCTEC Ingressa — backend — variáveis de ambiente (exemplo)
#
# Copie este arquivo para .env e preencha com valores reais do seu ambiente
# local. NUNCA versione o arquivo .env (já está no .gitignore da raiz do
# repositório). Nenhum valor abaixo é um segredo real.

# --- Banco de dados (MariaDB) ---
# Usadas por: testes de integração opcionais, e pelo CLI de migrations
# (src/cli/migrate.ts — npm run migrate:status/up/down/down-all). Nenhuma
# conexão é aberta automaticamente ao iniciar a aplicação (server.ts) —
# GET /health não consulta banco.
#
# v0.4.2: dois usuários distintos contra pctec_ingressa_dev (aprovado
# pelo Product Owner/Platform Architect — ver
# docs/07-operacao/MIGRATIONS-DEV-RUNBOOK.md):
#   pctec_ingressa_dev_migrator — só para o CLI de migrations (CREATE/ALTER/DROP)
#   pctec_ingressa_dev_app      — runtime do backend (só SELECT/INSERT/UPDATE/DELETE)
# DB_USER abaixo é só um placeholder de exemplo; escolha o usuário certo
# para o que for rodar.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pctec_ingressa
DB_USER=pctec_ingressa_dev_app
DB_PASSWORD=

# --- Testes de integração ---
# Defina como "true" para habilitar os testes marcados como integração
# (*.integration.test.ts), que exigem uma conexão MariaDB real disponível
# nas variáveis DB_* acima. Por padrão, "npm test" NUNCA executa esses
# testes, independentemente desta variável.
RUN_INTEGRATION_TESTS=false

# --- Servidor HTTP (v0.4.1 — Runtime Bootstrap) ---
# HOST fica em 127.0.0.1 por padrão: nesta fatia não há Nginx nem outro
# proxy reverso na frente do processo, então o bind deve ficar restrito
# ao loopback. PORT 3011 é a porta reservada para o ingressa-backend
# (ver ecosystem.config.cjs).
HOST=127.0.0.1
PORT=3011

# --- CLI de migrations (v0.4.2) ---
# Gate duplo para "npm run migrate:down"/"migrate:down-all": a execução
# destrutiva real só ocorre com --yes E esta variável em "true" ao mesmo
# tempo. Mantenha "false" por padrão — nunca versione "true" aqui.
# Além disso, NODE_ENV=production sempre recusa comandos destrutivos,
# independentemente desta variável.
MIGRATIONS_ALLOW_DESTRUCTIVE=false

# --- Aplicação ---
NODE_ENV=development

# --- Credencial service-to-service Ingressa <-> Portal (P1A.1, v0.7.x) ---
# Protege GET /api/v1/service/portal/... — rota chamada pelo backend do
# pctec-portal (nunca por um browser). Mesmo nome/valor nos dois
# sistemas (é um único segredo compartilhado no canal, não dois
# segredos coincidentemente parecidos). Vazio/ausente = rota totalmente
# indisponível (fail-closed absoluto — nunca "sem credencial = aceita
# qualquer coisa"). Nenhum valor abaixo é um segredo real.
INGRESSA_PORTAL_SERVICE_CREDENTIAL=

# --- Autenticação central e SSO first-party (v1.0) ---
# Base pública da UI do Ingressa. Usada exclusivamente para montar o link
# do convite (<base>/convite#<token>). Vazia = emissão de convites
# indisponível — nunca um link para "undefined/convite".
INGRESSA_PUBLIC_BASE_URL=https://ingressa-dev.pctec.com.br

# Lista FECHADA de redirect_uri aceitos no SSO do Portal, separados por
# vírgula, em forma ABSOLUTA e EXATA (comparação por igualdade de string;
# nunca prefixo, nunca curinga — é isto que impede open redirect).
# Vazia = SSO do Portal indisponível (fail-closed).
SSO_PORTAL_REDIRECT_URIS=https://portal-dev.pctec.com.br/api/auth/ingressa/callback

# URL que INICIA o fluxo, do lado do Portal — é para onde o card do
# launcher aponta. Vazia = card aparece desabilitado (o acesso existe, o
# destino é que não foi configurado).
SSO_PORTAL_LAUNCH_URL=https://portal-dev.pctec.com.br/api/auth/ingressa/start

# Mesmo papel, para o card do Helpdesk. Vazia = card desabilitado.
HELPDESK_LAUNCH_URL=

# Validade do código de autorização, em segundos. O teto real (60) vive
# no agregado AuthorizationCode — esta variável só permite ENCURTAR.
SSO_AUTHORIZATION_CODE_TTL_SECONDS=60

# --- Convite de primeiro acesso (v1.0) ---
# Validade do convite, em segundos. Padrão 24h; teto de 7 dias no domínio.
INVITATION_TTL_SECONDS=86400

# MANUAL_DEV: o link é exibido UMA vez ao ADMIN e NENHUM e-mail é
# enviado. EMAIL: entrega pelo SMTP próprio do Ingressa.
# NODE_ENV=production RECUSA MANUAL_DEV (ver loadEnv) — configurar SMTP é
# um bloqueio explícito para produção, nunca contornado por omissão.
INVITATION_DELIVERY_MODE=MANUAL_DEV

# Variáveis PRÓPRIAS do Ingressa — nunca compartilhadas com o Portal, e
# nunca lidas do arquivo de outro produto em runtime. Nenhum valor real
# aqui e nenhum no Git. Ausentes, o modo EMAIL falha no boot com erro
# operacional explícito, nunca cai de volta para MANUAL_DEV.
#
# ORIGEM OPERACIONAL EM PRODUÇÃO (decisão do Product Owner, v1.0): os
# valores são copiados UMA VEZ, à mão, do `.env` do PCTEC Hub. A cópia é
# de VALOR, com tradução de nome — nunca symlink, nunca leitura cruzada:
#
#   Hub SMTP_HOST  ->  INGRESSA_SMTP_HOST
#   Hub SMTP_PORT  ->  INGRESSA_SMTP_PORT
#   Hub SMTP_USER  ->  INGRESSA_SMTP_USER
#   Hub SMTP_PASS  ->  INGRESSA_SMTP_PASSWORD
#   Hub SMTP_FROM  ->  INGRESSA_SMTP_FROM
#
# O Hub NÃO tem variável de TLS/secure — INGRESSA_SMTP_SECURE é contrato
# novo do Ingressa e precisa de decisão operacional própria (abaixo).
# LIMITAÇÃO ACEITA: a caixa é a mesma dos dois produtos, então ROTACIONAR
# a senha no Hub quebra o envio de convites do Ingressa até que o novo
# valor seja copiado para cá — e vice-versa. Ver docs/07-operacao/.
INGRESSA_SMTP_HOST=
INGRESSA_SMTP_PORT=587
INGRESSA_SMTP_USER=
INGRESSA_SMTP_PASSWORD=
INGRESSA_SMTP_FROM=

# Modo de TLS, EXPLÍCITO:
#   true  -> TLS implícito, conexão já nasce cifrada (porta 465)
#   false -> conexão elevada por STARTTLS (porta 587)
# Ausente = derivado da porta (465 -> true, qualquer outra -> false).
# A derivação nunca enfraquece a conexão: com NODE_ENV=production o
# backend exige TLS de qualquer forma (requireTLS), então uma omissão
# jamais resulta em senha ou link de convite trafegando em claro.
INGRESSA_SMTP_SECURE=

# ---------------------------------------------------------------------
# Fonte HELPDESK (assistente de importação) — v0.12.x
# ---------------------------------------------------------------------
#
# Estas variáveis NÃO moram neste arquivo em servidor: elas vivem em
# `/app/.config/pctec-ingressa/helpdesk-source.env` (dir 700, arquivo
# 600, fora do repositório), carregado pelo Node com um `--env-file`
# próprio. Ficam listadas aqui só como contrato — nomes e formatos,
# nunca valores.
#
# HELPDESK_DB_NAME é o schema do Helpdesk (a conexão).
# HELPDESK_REGISTRY_DB_NAME é o schema do REGISTRO AUTORITATIVO de
# empresas, que é OUTRO schema no mesmo servidor: é de lá que o próprio
# Helpdesk lê o cadastro de clientes, e é de lá que o assistente lê.
# São dois porque são coisas diferentes — a conexão é do Helpdesk, o
# cadastro é de outro sistema. Sem default, e é deliberado: um default
# aqui seria o nome do schema fixo no código por outro caminho.
#
# O JOIN entre os dois schemas usa a MESMA conexão. Por isso o GRANT da
# credencial precisa alcançar as colunas nos dois lugares — e apenas
# elas. Ver docs/07-operacao/.
HELPDESK_DB_HOST=127.0.0.1
HELPDESK_DB_PORT=3306
HELPDESK_DB_NAME=pctec_helpdesk
HELPDESK_REGISTRY_DB_NAME=pctecdb
HELPDESK_DB_USER=pctec_helpdesk_ingressa_ro
HELPDESK_DB_PASSWORD=

# ---------------------------------------------------------------------
# Fonte PORTAL (catálogo de clientes) — v0.12.x
# ---------------------------------------------------------------------
#
# Mesma regra: valores reais em
# `/app/.config/pctec-ingressa/portal-source.env`, nunca aqui.
# Ausentes, as rotas do catálogo respondem 503 com código próprio —
# fail-closed deliberado, nunca um default de host, usuário ou senha.
PORTAL_SOURCE_DB_HOST=127.0.0.1
PORTAL_SOURCE_DB_PORT=3306
PORTAL_SOURCE_DB_NAME=pctecdb
PORTAL_SOURCE_DB_USER=pctec_ingressa_portal_ro
PORTAL_SOURCE_DB_PASSWORD=

{
  "name": "@pctec/ingressa-backend",
  "version": "0.5.0",
  "private": true,
  "description": "PCTEC Ingressa — backend (v0.5.0 Identity API, Vertical Slice 1 — Identity Query API)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migration-assets.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:watch": "vitest",
    "migrate:status": "node dist/cli/migrate.js status",
    "migrate:up": "node dist/cli/migrate.js up",
    "migrate:up:dry-run": "node dist/cli/migrate.js up --dry-run",
    "migrate:down": "node dist/cli/migrate.js down",
    "migrate:down-all": "node dist/cli/migrate.js down-all",
    "bootstrap:first-identity": "node dist/cli/bootstrap-first-identity.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mysql2": "3.11.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "22.5.5",
    "tsx": "^4.23.9",
    "typescript": "5.6.2",
    "vitest": "2.1.1"
  }
}

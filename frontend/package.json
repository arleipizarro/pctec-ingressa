    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.1",
    "typescript": "5.6.2",
    "vite": "^5.4.8",
    "vitest": "2.1.1"

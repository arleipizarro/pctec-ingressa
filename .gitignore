# Environment
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Builds
dist/
build/
coverage/

# Logs
*.log
logs/

# Runtime
*.pid
*.seed
*.pid.lock

# Databases and backups
*.sql
*.dump
*.bak
*.backup

# Exceção: migrations reversíveis versionadas do backend (Identity Core).
# Migrations são artefatos de código revisáveis, não dumps/backups de
# dados — precisam ser versionadas para revisão arquitetural e histórico,
# mesmo estando sob a extensão .sql coberta pela regra geral acima.
!backend/src/shared/database/migrations/*.up.sql
!backend/src/shared/database/migrations/*.down.sql

# Editors
.vscode/
.idea/
*.swp
*.swo

# Operating systems
.DS_Store
Thumbs.db

# Secrets and certificates
*.pem
*.key
*.crt
secrets/

# Temporary files
tmp/
temp/
.cache/
